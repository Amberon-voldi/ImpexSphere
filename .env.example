# PostgreSQL connection string (required).
# Run `npm run db:migrate` after setting it to create the tables.
DATABASE_URL=postgres://user:password@localhost:5432/impexsphere

# Optional: email notification for each new submission via Resend (https://resend.com).
# Submissions are always stored in Postgres; email is only a notification.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=ImpexSphere <noreply@yourdomain.com>
